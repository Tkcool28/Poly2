# --- Core mode flags (safe defaults: paper mode, kill switch ON) ---
POLYCOPY_ENVIRONMENT=development
POLYCOPY_PAPER_MODE=true
POLYCOPY_ALLOW_LIVE_TRADING=false
POLYCOPY_ORDER_KILL_SWITCH=true

# NEVER set this while POLYCOPY_ALLOW_LIVE_TRADING=false — config will refuse to start.
# POLYCOPY_POLYMARKET_PRIVATE_KEY=

# --- Database / cache ---
POLYCOPY_POSTGRES_USER=
POLYCOPY_POSTGRES_PASSWORD=
POLYCOPY_POSTGRES_DB=polycopy
# Set to postgresql+asyncpg://<URL-encoded user>:<URL-encoded password>@postgres:5432/<database>
# Use the same credentials and database as the three variables above.
POLYCOPY_DATABASE_URL=
POLYCOPY_REDIS_URL=redis://redis:6379/0

# --- Host ingress (Caddy proxies to this loopback listener) ---
POLYCOPY_BIND_ADDRESS=127.0.0.1
POLYCOPY_HTTP_PORT=8790

# --- API ---
POLYCOPY_API_HOST=0.0.0.0
POLYCOPY_API_PORT=8000
POLYCOPY_LOG_LEVEL=INFO

# --- Risk limits (enforced by the bot starting in Chunk 2) ---
POLYCOPY_MAX_ORDER_SIZE_USD=25
POLYCOPY_MAX_EXPOSURE_PER_MARKET_USD=100
POLYCOPY_MAX_EXPOSURE_GLOBAL_USD=200
POLYCOPY_REVIEW_DELAY_SECONDS=30

# --- Paper bankroll (seeds the account on first use; adjustable in the app after that) ---
# Starting cash the paper bot knows it has. No refill path exists.
POLYCOPY_STARTING_BANKROLL_USD=200
# Profit limit: accumulated un-withdrawn profit at/above this is swept out
# (simulated transfer to your real account). 0 disables the sweep.
POLYCOPY_PROFIT_LIMIT_USD=50
# Stop-loss floor: at/below this balance the bot stops opening NEW
# positions (sells/settlements still run). 0 disables the halt.
POLYCOPY_STOP_LOSS_FLOOR_USD=100

# --- Ingestion bounds (Chunk 2) — hard caps so the VPS can never be OOMed again ---
POLYCOPY_INGESTION_BATCH_SIZE=500
POLYCOPY_INGESTION_MAX_CONCURRENT_REQUESTS=4
POLYCOPY_INGESTION_POLL_INTERVAL_SECONDS=15

# --- Prospective Shadow comparison (OFF; never a trading control) ---
# Future installation/activation requires separate operator approval. See docs/shadow-capture-v1.md.
POLYCOPY_SHADOW_CAPTURE_ENABLED=false
POLYCOPY_SHADOW_CAPTURE_BACKEND_WORKER=
POLYCOPY_SHADOW_CAPTURE_BOT_WORKER=
# Host-checkout processes use SERVICE and WORKER explicitly instead of the compose role variables.
POLYCOPY_SHADOW_CAPTURE_SERVICE=
POLYCOPY_SHADOW_CAPTURE_WORKER=
POLYCOPY_SHADOW_CAPTURE_RUN_ID=
POLYCOPY_SHADOW_CAPTURE_GENERATION_ID=
POLYCOPY_SHADOW_CAPTURE_AUTHORITY_PATH=
POLYCOPY_SHADOW_CAPTURE_AUTHORITY_PIN=
POLYCOPY_SHADOW_CAPTURE_PRIVATE_KEY_PATH=
POLYCOPY_SHADOW_CAPTURE_FENCE_PATH=
POLYCOPY_SHADOW_CAPTURE_DRAIN_PATH=
POLYCOPY_SHADOW_CAPTURE_HANDOFF_PATH=
POLYCOPY_SHADOW_CAPTURE_HEALTH_PATH=
